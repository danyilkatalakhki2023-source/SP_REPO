PROGRAM Pro
VAR INT32_t _Aaa, _Bbb, _Xxx, _Yyy;
START
  READ(_Aaa);
  READ(_Bbb);

  WRITE(_Aaa ADD _Bbb);
  WRITE(_Aaa SUB _Bbb);
  WRITE(_Aaa MUL _Bbb);
  WRITE(_Aaa DIV _Bbb);
  WRITE(_Aaa MOD _Bbb);

  ((_Aaa SUB _Bbb) MUL 10) ADD ((_Aaa ADD _Bbb) DIV 10) -> _Xxx;
  
  _Xxx ADD (_Xxx MOD 10) -> _Yyy;

  WRITE(_Xxx);
  WRITE(_Yyy);
FINISH
