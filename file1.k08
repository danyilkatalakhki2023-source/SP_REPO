PROGRAM Pro
VAR INT32 Aaa, Bbb, Xxx, Yyy;
START
  READ(Aaa);
  READ(Bbb);

  WRITE(Aaa ADD Bbb);
  WRITE(Aaa SUB Bbb);
  WRITE(Aaa MUL Bbb);
  WRITE(Aaa DIV Bbb);
  WRITE(Aaa MOD Bbb);

  ((Aaa SUB Bbb) MUL 10) ADD ((Aaa ADD Bbb) DIV 10) -> Xxx;
  
  Xxx ADD (Xxx MOD 10) -> Yyy;

  WRITE(Xxx);
  WRITE(Yyy);
FINISH
