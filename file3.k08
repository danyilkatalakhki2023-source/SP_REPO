PROGRAM Loop
VAR INT32_t _Aaa, _Bbb, _Cyc, _Cyb, _Val, _Idx;
START
  READ(_Aaa);
  READ(_Bbb);

  FOR _Idx = _Bbb DOWNTO _Aaa DO {
     (_Aaa ADD _Bbb) SUB _Idx -> _Cyc;
     WRITE(_Cyc MUL _Cyc);
  }

  0 -> _Val;
  
  FOR _Cyc = _Aaa DOWNTO 1 DO {
    FOR _Cyb = _Bbb DOWNTO 1 DO {
       _Val ADD 1 -> _Val;
    }
  }
  
  WRITE(_Val);
FINISH
