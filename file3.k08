PROGRAM Loop
VAR INT32 Aaa, Bbb, Cyc, Cyb, Val, Idx;
START
  READ(Aaa);
  READ(Bbb);

  FOR Idx = Bbb DOWNTO Aaa DO {
     (Aaa ADD Bbb) SUB Idx -> Cyc;
     WRITE(Cyc MUL Cyc);
  }

  0 -> Val;
  
  FOR Cyc = Aaa DOWNTO 1 DO {
    FOR Cyb = Bbb DOWNTO 1 DO {
       Val ADD 1 -> Val;
    }
  }
  
  WRITE(Val);
FINISH
