PROGRAM Prg
VAR INT32 Aaa, Bbb, Ccc, Max;
START
  READ(Aaa);
  READ(Bbb);
  READ(Ccc);

  IF ((Aaa GT Bbb) OR (Aaa EQ Bbb)) AND ((Aaa GT Ccc) OR (Aaa EQ Ccc)) {
    Aaa -> Max;
  } ELSE {
    IF ((Bbb GT Aaa) OR (Bbb EQ Aaa)) AND ((Bbb GT Ccc) OR (Bbb EQ Ccc)) {
      Bbb -> Max;
    } ELSE {
      Ccc -> Max;
    }
  }
  WRITE(Max);

  IF (Aaa EQ Bbb) AND (Aaa EQ Ccc) AND (Bbb EQ Ccc) {
    WRITE(1);
  } ELSE {
    WRITE(0);
  }

  IF (NOT ((Aaa GT 0) OR (Aaa EQ 0))) OR (NOT ((Bbb GT 0) OR (Bbb EQ 0))) OR (NOT ((Ccc GT 0) OR (Ccc EQ 0))) {
    WRITE(-1);
  } ELSE {
    WRITE(0);
  }

  IF (Aaa GT (Bbb ADD Ccc)) OR (Aaa EQ (Bbb ADD Ccc)) {
    WRITE(10);
  } ELSE {
    WRITE(0);
  }
FINISH
