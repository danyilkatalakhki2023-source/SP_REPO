PROGRAM Prg
VAR INT32_t _Aaa, _Bbb, _Ccc, _Max;
START
  READ(_Aaa);
  READ(_Bbb);
  READ(_Ccc);

  IF ((_Aaa GT _Bbb) OR (_Aaa EQ _Bbb)) AND ((_Aaa GT _Ccc) OR (_Aaa EQ _Ccc)) {
    _Aaa -> _Max;
  } ELSE {
    IF ((_Bbb GT _Aaa) OR (_Bbb EQ _Aaa)) AND ((_Bbb GT _Ccc) OR (_Bbb EQ _Ccc)) {
      _Bbb -> _Max;
    } ELSE {
      _Ccc -> _Max;
    }
  }
  WRITE(_Max);

  IF (_Aaa EQ _Bbb) AND (_Aaa EQ _Ccc) AND (_Bbb EQ _Ccc) {
    WRITE(1);
  } ELSE {
    WRITE(0);
  }

  IF (NOT ((_Aaa GT 0) OR (_Aaa EQ 0))) OR (NOT ((_Bbb GT 0) OR (_Bbb EQ 0))) OR (NOT ((_Ccc GT 0) OR (_Ccc EQ 0))) {
    WRITE(-1);
  } ELSE {
    WRITE(0);
  }

  IF (_Aaa GT (_Bbb ADD _Ccc)) OR (_Aaa EQ (_Bbb ADD _Ccc)) {
    WRITE(10);
  } ELSE {
    WRITE(0);
  }
FINISH
