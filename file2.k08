program LogicalOperations {
  INT Aaa, Bbb, Ccc, Max;

  read(Aaa);
  read(Bbb);
  read(Ccc);

  if Aaa Ge Bbb and Aaa Ge Ccc {
    Max := Aaa;
  } else if Bbb Ge Aaa and Bbb Ge Ccc {
    Max := Bbb;
  } else {
    Max := Ccc;
  }
  write(Max);

  if (Aaa Eq Bbb) and (Aaa Eq Ccc) and (Bbb Eq Ccc) {
    write(1);
  } else {
    write(0);
  }
  
  if not (Aaa Ge 0) or not (Bbb Ge 0) or not (Ccc Ge 0) {
    write(-1);
  } else {
    write(0);
  }

  if Aaa Ge (Bbb Add Ccc) {
    write(10);
  } else {
    write(0);
  }
}
